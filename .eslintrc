{
  "env": {
    "node": true,
    "es2021": true,
  },
  "extends": ["airbnb-base", "prettier"],
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module",
  },
  "rules": {
    "no-underscore-dangle": ["error", { "allow": ["_id"] }],
    "no-warning-comments": [
      "error",
      {
        "terms": [
          "eslint-disable",
          "eslint-disable-line",
          "eslint-disable-next-line",
        ],
        "location": "anywhere",
      },
    ],
  },
}
